---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'NTU HPC/AI | High Performance Computing and Artificial Intelligence',
  description = 'NTU HPC/AI is a student-run team exploring high performance computing, artificial intelligence, systems, and performance engineering.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/ntu-hpc-logo.svg" />
		<link rel="icon" href="/ntu-hpc-logo.ico" sizes="any" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
