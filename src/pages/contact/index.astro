---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import chenWangPhoto from '../../../assets/advisor-images/DrWangChen.jpg';
import lokeYuanRenPhoto from '../../../assets/advisor-images/DrLoke.jpg';

const advisors = [
  {
    name: 'Asst Prof Chen Wang',
    appointment: 'Assistant Professor',
    college: 'College of Computing and Data Science',
    email: 'chen.wang@ntu.edu.sg',
    profile: 'https://wangchen.io',
    photo: chenWangPhoto,
  },
  {
    name: 'Dr Loke Yuan Ren',
    appointment: 'Lecturer',
    college: 'College of Computing and Data Science',
    email: 'yrloke@ntu.edu.sg',
    profile: 'https://dr.ntu.edu.sg/entities/person/Loke-Yuan-Ren',
    photo: lokeYuanRenPhoto,
  },
];
---

<Layout
  title="Contact Us | NTU HPC/AI"
  description="Contact the NTU HPC/AI student advisors about joining the club or becoming a partner."
>
  <section class="relative flex min-h-[20rem] items-center overflow-hidden bg-brand-navy py-10 text-brand-text-on-dark">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_82%_45%,rgba(226,85,116,0.18),transparent_34%)]" aria-hidden="true"></div>
    <svg class="absolute right-8 top-1/2 hidden h-52 w-96 -translate-y-1/2 text-brand-rose/55 lg:block" viewBox="0 0 400 220" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M40 57h195v126H40z" />
      <path d="m42 60 96 75 96-75" />
      <path d="m42 181 69-65M234 181l-69-65" stroke-opacity=".55" />
      <circle cx="304" cy="72" r="28" />
      <path d="M259 166c3-34 20-52 45-52s42 18 45 52" />
      <path d="M270 199h68" stroke="#F7F8FB" stroke-opacity=".25" />
    </svg>
    <div class="relative mx-auto w-full max-w-7xl px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-rose">Connect with NTU HPC/AI</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Contact Us</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-brand-text-on-dark/85">
        Interested in joining the club or supporting our work? Contact one of our student advisors to start the conversation.
      </p>
    </div>
  </section>

  <section class="bg-brand-page py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-6 lg:px-8">
      <div class="grid gap-5 sm:grid-cols-2">
        <article class="rounded-2xl border border-brand-border bg-brand-surface p-6 shadow-sm sm:p-8">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-rose-soft text-brand-rose" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8M19 8v6M16 11h6" /></svg>
          </span>
          <p class="mt-5 text-sm font-bold uppercase tracking-[0.12em] text-brand-rose">For students</p>
          <h2 class="mt-2 text-2xl font-extrabold text-brand-navy">Interested in joining?</h2>
          <p class="mt-3 leading-7 text-brand-muted">Reach out if you would like to learn more about the club, its activities, and how to get involved.</p>
        </article>

        <article class="rounded-2xl border border-brand-border bg-brand-surface p-6 shadow-sm sm:p-8">
          <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-rose-soft text-brand-rose" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 3h5v5M21 3l-7 7M8 7H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3" /><path d="M8 13h5v5H8z" /></svg>
          </span>
          <p class="mt-5 text-sm font-bold uppercase tracking-[0.12em] text-brand-rose">For organisations</p>
          <h2 class="mt-2 text-2xl font-extrabold text-brand-navy">Interested in partnering?</h2>
          <p class="mt-3 leading-7 text-brand-muted">Contact our advisors to discuss sponsorships, technical collaboration, workshops, or other partnership opportunities.</p>
        </article>
      </div>

      <div class="mt-14 text-center">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-rose">Student advisors</p>
        <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-brand-navy">Who to contact</h2>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {advisors.map((advisor) => (
          <article class="rounded-3xl border border-brand-border bg-brand-surface p-5 shadow-sm sm:p-6">
            <div class="grid min-h-full grid-cols-[7rem_minmax(0,1fr)] gap-5 sm:grid-cols-[8rem_minmax(0,1fr)]">
              <Image class="aspect-square h-28 w-28 rounded-2xl border-2 border-brand-rose-soft object-cover shadow-sm sm:h-32 sm:w-32" src={advisor.photo} alt={`Portrait of ${advisor.name}`} width={128} height={128} loading="lazy" />
              <div class="flex min-w-0 flex-col">
                <p class="text-xs font-bold uppercase tracking-[0.13em] text-brand-rose">Student Advisor</p>
                <h3 class="mt-2 text-xl font-extrabold leading-tight text-brand-navy sm:text-2xl">{advisor.name}</h3>
                <p class="mt-3 text-sm font-semibold text-brand-text">{advisor.appointment}</p>
                <p class="mt-1 text-sm leading-5 text-brand-muted">{advisor.college}<br />Nanyang Technological University</p>
                <a class="mt-3 break-all text-sm font-semibold text-brand-rose transition hover:text-brand-navy" href={`mailto:${advisor.email}`}>{advisor.email}</a>
                <div class="mt-auto flex flex-wrap gap-2 pt-5">
                  <a class="inline-flex items-center gap-2 rounded-lg bg-brand-rose px-3.5 py-2 text-sm font-bold text-white transition hover:bg-brand-coral focus:outline-none focus:ring-2 focus:ring-brand-rose focus:ring-offset-2" href={`mailto:${advisor.email}`}>
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                    Email
                  </a>
                  <a class="inline-flex items-center gap-2 rounded-lg border border-brand-border px-3.5 py-2 text-sm font-bold text-brand-navy transition hover:border-brand-rose hover:text-brand-rose focus:outline-none focus:ring-2 focus:ring-brand-rose focus:ring-offset-2" href={advisor.profile} target="_blank" rel="noreferrer">
                    Profile <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-10 flex flex-col items-start justify-between gap-5 rounded-2xl border border-brand-border bg-brand-navy px-6 py-6 text-brand-text-on-dark sm:flex-row sm:items-center sm:px-8">
        <div class="flex items-center gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-rose/15 text-brand-rose" aria-hidden="true">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M6.5 8.5H3V21h3.5V8.5ZM4.75 3A2.05 2.05 0 1 0 4.75 7.1 2.05 2.05 0 0 0 4.75 3ZM21 13.8c0-3.77-2.01-5.52-4.7-5.52-2.17 0-3.14 1.19-3.68 2.03V8.5H9.12V21h3.5v-6.19c0-1.63.31-3.2 2.33-3.2 1.99 0 2.01 1.86 2.01 3.31V21H21v-7.2Z" /></svg>
          </span>
          <div>
            <p class="font-extrabold">Follow NTU HPC/AI on LinkedIn</p>
            <p class="mt-1 text-sm text-brand-text-on-dark/70">Keep up with our events, competition results, and club updates.</p>
          </div>
        </div>
        <a class="inline-flex shrink-0 items-center gap-2 rounded-xl border border-brand-rose px-5 py-2.5 text-sm font-bold text-brand-text-on-dark transition hover:bg-brand-rose hover:text-white focus:outline-none focus:ring-2 focus:ring-brand-rose focus:ring-offset-2 focus:ring-offset-brand-navy" href="https://www.linkedin.com/company/ntu-hpc/posts/?feedView=all" target="_blank" rel="noreferrer">
          Visit LinkedIn <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
