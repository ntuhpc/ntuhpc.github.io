---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection, getEntry } from 'astro:content';
import { readdir } from 'node:fs/promises';
import { join } from 'node:path';
import defaultAvatar from '../../../assets/member-images/default-avatar.png';
import ResultBadge from '../../components/achievements/ResultBadge.astro';
import Layout from '../../layouts/Layout.astro';

const avatarModules = import.meta.glob('../../../assets/member-images/*.{avif,jpeg,jpg,png,webp}', {
  eager: true,
  import: 'default',
}) as Record<string, ImageMetadata>;

const getAvatar = (filename: string) =>
  avatarModules[`../../../assets/member-images/${filename}`] ?? defaultAvatar;

const achievements = (await getCollection('achievements'))
  .filter((achievement) => !achievement.data.draft)
  .sort((first, second) => second.data.date.getTime() - first.data.date.getTime());

const dateFormatter = new Intl.DateTimeFormat('en-SG', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const formatAchievementDate = (achievement: (typeof achievements)[number]) =>
  achievement.data.yearOnly ? String(achievement.data.date.getFullYear()) : dateFormatter.format(achievement.data.date);

const years = [...new Set(achievements.map((achievement) => achievement.data.date.getFullYear()))];
const awardCount = achievements.reduce((total, achievement) => total + achievement.data.results.length, 0);
const imageFilePattern = /\.(avif|gif|jpe?g|png|webp)$/i;

const getGalleryImages = async (folder?: string, competitionLogo?: string) => {
  if (!folder) return [];

  try {
    const files = await readdir(join(process.cwd(), 'public', 'images', 'achievements', folder), { withFileTypes: true });
    return files
      .filter((file) => file.isFile() && imageFilePattern.test(file.name))
      .map((file) => `/images/achievements/${folder}/${file.name}`)
      // A competition logo identifies the timeline entry; it is never a gallery photo.
      .filter((imagePath) => imagePath !== competitionLogo);
  } catch {
    return [];
  }
};

const achievementGalleries = await Promise.all(
  achievements.map(async (achievement) => ({
    id: achievement.id,
    images: await getGalleryImages(achievement.data.galleryFolder, achievement.data.competitionLogo),
  })),
);

const getGallery = (achievementId: string) =>
  achievementGalleries.find((entry) => entry.id === achievementId)?.images ?? [];

const achievementMembers = await Promise.all(
  achievements.map(async (achievement) => ({
    id: achievement.id,
    members: (await Promise.all(achievement.data.teamMembers.map((member) => getEntry(member)))).filter(Boolean),
  })),
);

const getMembers = (achievementId: string) =>
  achievementMembers.find((entry) => entry.id === achievementId)?.members ?? [];
---

<Layout title="Our Achievements | NTU HPC/AI" description="Explore NTU HPC/AI's competition results and milestones.">
  <section class="relative flex min-h-[20rem] items-center overflow-hidden bg-brand-navy py-10 text-brand-text-on-dark">
    <div class="absolute inset-0 opacity-60" aria-hidden="true">
      <div class="absolute -right-20 -top-28 h-80 w-80 rounded-full border border-brand-rose/30"></div>
      <div class="absolute right-16 top-16 h-52 w-52 rounded-full border border-brand-text-on-dark/15"></div>
      <div class="absolute inset-x-0 bottom-0 h-36 bg-[radial-gradient(circle_at_72%_80%,rgba(226,85,116,0.28),transparent_62%)]"></div>
    </div>
    <svg class="absolute right-8 top-1/2 hidden h-48 w-48 -translate-y-1/2 text-brand-text-on-dark/20 lg:block" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="5" aria-hidden="true">
      <path d="M62 36h76v30c0 30-17 54-38 54S62 96 62 66V36Z" />
      <path d="M62 52H40c0 28 12 43 31 45M138 52h22c0 28-12 43-31 45M100 120v27M70 164h60M78 147h44" />
      <path d="m100 57 8 17 19 3-14 13 3 19-16-9-16 9 3-19-14-13 19-3 8-17Z" stroke="#E25574" />
    </svg>
    <div class="relative mx-auto w-full max-w-7xl px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-rose">Competition and community milestones</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Our Achievements</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-brand-text-on-dark/85">A growing record of the challenges NTU HPC/AI has taken on, the results earned, and the people behind them.</p>
    </div>
  </section>

  <section class="bg-brand-page py-14 sm:py-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      {achievements.length > 0 ? (
        <div class="grid min-w-0 grid-cols-[minmax(0,1fr)] items-start gap-8 lg:grid-cols-[minmax(18rem,0.8fr)_minmax(0,1.2fr)]">
          <section id="award-history" class="min-w-0 scroll-mt-24 lg:max-h-screen lg:overflow-y-auto lg:pr-4" aria-labelledby="timeline-heading">
            <div class="flex min-w-0 flex-wrap items-end justify-between gap-4">
              <div>
                <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-rose">Timeline</p>
              <h2 id="timeline-heading" class="mt-2 text-3xl font-extrabold tracking-tight text-brand-navy">Award History</h2>
            </div>
              <span class="rounded-full bg-brand-rose-soft px-3 py-1 text-sm font-bold text-brand-navy">{awardCount} {awardCount === 1 ? 'Award' : 'Awards'}</span>
            </div>

            <div class="relative mt-8 min-w-0 space-y-9 before:absolute before:bottom-3 before:left-[11px] before:top-3 before:w-px before:bg-brand-border">
              {years.map((year) => (
                <div class="min-w-0">
                  <h3 class="relative pl-8 text-xl font-extrabold text-brand-navy"><span class="absolute left-0 top-1.5 h-[23px] w-[23px] rounded-full border-4 border-brand-page bg-brand-rose"></span>{year}</h3>
                  <div class="mt-4 min-w-0 space-y-4 pl-6 sm:pl-8">
                    {achievements.filter((achievement) => achievement.data.date.getFullYear() === year).map((achievement) => (
                      <button class="achievement-select group min-w-0 w-full max-w-full rounded-2xl border border-brand-border bg-brand-surface p-4 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-brand-rose hover:shadow-md focus:outline-none focus:ring-2 focus:ring-brand-rose sm:p-5" type="button" data-achievement-select={achievement.id} aria-controls="achievement-details" aria-expanded="false">
                        <div class="grid grid-cols-[4rem_minmax(0,1fr)] gap-3 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-4">
                          <div class="flex h-16 w-16 items-center justify-center sm:h-28 sm:w-28">
                            {achievement.data.competitionLogo ? (
                              <Image class="h-full w-full object-contain" src={achievement.data.competitionLogo} alt={`${achievement.data.competition} logo`} width={112} height={112} loading="lazy" />
                            ) : (
                              <svg class="h-9 w-9 text-brand-rose" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 4h10v4a5 5 0 0 1-10 0V4ZM7 6H4a3 3 0 0 0 3 3M17 6h3a3 3 0 0 1-3 3M12 13v4M8 21h8M9 17h6" /></svg>
                            )}
                          </div>
                          <div class="min-w-0">
                            <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-rose">{formatAchievementDate(achievement)}</p>
                            <h4 class="mt-2 text-lg font-extrabold leading-6 text-brand-navy group-hover:text-brand-rose">{achievement.data.title}</h4>
                            <p class="mt-2 text-sm font-semibold text-brand-muted">{achievement.data.competition}</p>
                          </div>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                          {achievement.data.results.map((result) => <ResultBadge placement={result.placement} label={result.label} compact />)}
                        </div>
                      </button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <section id="achievement-details" class="min-w-0 mt-8 lg:mt-0 lg:max-h-screen lg:overflow-y-auto lg:pr-4" aria-live="polite">
            {achievements.map((achievement, index) => {
              const images = Array.from(new Set([achievement.data.coverImage, ...getGallery(achievement.id)].filter(Boolean))) as string[];
              const members = getMembers(achievement.id);
              const results = achievement.data.results;
              return (
                <article class:list={["achievement-panel scroll-mt-24 rounded-3xl border border-brand-border bg-brand-surface p-5 shadow-sm sm:p-8", { hidden: index !== 0 }]} data-achievement-panel={achievement.id} aria-label={`${achievement.data.title} details`}>
                  <button class="mb-5 inline-flex items-center gap-2 text-sm font-bold text-brand-rose lg:hidden" type="button" data-achievement-back>
                    <span aria-hidden="true">&larr;</span> Back to award history
                  </button>
                  <div>
                    <div>
                      <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-rose">{achievement.data.category ?? 'Achievement'}</p>
                      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-brand-navy sm:text-3xl">{achievement.data.title}</h2>
                      <p class="mt-3 text-sm font-semibold text-brand-muted">{formatAchievementDate(achievement)}{achievement.data.location && ` · ${achievement.data.location}`}</p>
                    </div>
                  </div>

                  <div class="mt-6 grid gap-3 sm:grid-cols-2">
                    {results.map((result) => <ResultBadge placement={result.placement} label={result.label} />)}
                  </div>
                  <p class="mt-4 text-sm font-semibold text-brand-muted">{achievement.data.competition}</p>

                  {images.length > 0 && (
                    <div class="mt-7">
                      <Image class="h-64 w-full rounded-2xl border border-brand-border object-cover sm:h-80" src={images[0]} alt={`${achievement.data.title} competition photo`} width={960} height={640} data-achievement-main-image={achievement.id} loading={index === 0 ? 'eager' : 'lazy'} />
                      {images.length > 1 && (
                        <div class="mt-3 flex gap-3 overflow-x-auto pb-1">
                          {images.map((image, imageIndex) => <button class:list={["h-16 w-20 shrink-0 overflow-hidden rounded-lg border-2", imageIndex === 0 ? 'border-brand-rose' : 'border-transparent']} type="button" data-achievement-image={image} data-achievement-image-target={achievement.id} aria-label={`Show image ${imageIndex + 1}`}><Image class="h-full w-full object-cover" src={image} alt="" width={80} height={64} loading="lazy" /></button>)}
                        </div>
                      )}
                    </div>
                  )}

                  <p class="mt-7 text-base leading-7 text-brand-text">{achievement.data.summary}</p>
                  {achievement.data.about && (
                    <div class="mt-7 border-t border-brand-border pt-6">
                      <h3 class="text-lg font-extrabold text-brand-navy">About this achievement</h3>
                      <p class="mt-3 leading-7 text-brand-text">{achievement.data.about}</p>
                    </div>
                  )}

                  {members.length > 0 && (
                    <div class="mt-7 border-t border-brand-border pt-6">
                      <h3 class="text-lg font-extrabold text-brand-navy">Team members</h3>
                      <div class="mt-4 flex flex-wrap gap-4">
                        {members.map((member) => member && <a class="group flex items-center gap-3 rounded-xl p-1 pr-3 transition hover:bg-brand-rose-soft focus:outline-none focus:ring-2 focus:ring-brand-rose" href={`/team/?member=${encodeURIComponent(member.id)}#current-members`}><Image class="h-10 w-10 rounded-full border border-brand-border object-cover" src={getAvatar(member.data.photo)} alt="" width={40} height={40} /><span class="text-sm font-bold text-brand-navy group-hover:text-brand-rose">{member.data.name}</span></a>)}
                      </div>
                    </div>
                  )}

                </article>
              );
            })}
          </section>
        </div>
      ) : (
        <div class="rounded-3xl border border-brand-border bg-brand-surface p-8 text-center shadow-sm sm:p-12">
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-brand-rose">Achievements</p>
          <h2 class="mt-3 text-3xl font-extrabold text-brand-navy">More milestones are on their way.</h2>
          <p class="mx-auto mt-4 max-w-xl leading-7 text-brand-muted">Add a YAML file in <code>src/data/achievements/</code> to publish the first achievement here.</p>
        </div>
      )}
    </div>
  </section>
</Layout>

<script>
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-achievement-panel]'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-achievement-select]'));

  const openAchievement = (achievementId: string) => {
    const selectedPanel = panels.find((panel) => panel.dataset.achievementPanel === achievementId);
    if (!selectedPanel) return;

    panels.forEach((panel) => panel.classList.toggle('hidden', panel !== selectedPanel));
    buttons.forEach((button) => button.setAttribute('aria-expanded', String(button.dataset.achievementSelect === achievementId)));
  };

  buttons.forEach((button) => button.addEventListener('click', () => {
    const achievementId = button.dataset.achievementSelect ?? '';
    openAchievement(achievementId);

    if (window.matchMedia('(max-width: 1023px)').matches) {
      panels.find((panel) => panel.dataset.achievementPanel === achievementId)?.scrollIntoView({
        behavior: 'smooth',
        block: 'start',
      });
    }
  }));

  document.querySelectorAll<HTMLButtonElement>('[data-achievement-back]').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelector('#award-history')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-achievement-image]').forEach((button) => {
    button.addEventListener('click', () => {
      const target = document.querySelector<HTMLImageElement>(`[data-achievement-main-image="${button.dataset.achievementImageTarget}"]`);
      if (!target || !button.dataset.achievementImage) return;
      target.src = button.dataset.achievementImage;
      button.parentElement?.querySelectorAll('button').forEach((thumbnail) => thumbnail.classList.toggle('border-brand-rose', thumbnail === button));
    });
  });
</script>
