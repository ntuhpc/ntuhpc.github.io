---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const dateFormatter = new Intl.DateTimeFormat('en-SG', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const news = (await getCollection('news'))
  .filter((article) => !article.data.draft)
  .map((article) => ({
    ...article,
    articleType: article.data.type,
    filterType: 'news',
    href: `/news/${article.id}/`,
  }));

const blog = (await getCollection('blog'))
  .filter((article) => !article.data.draft)
  .map((article) => ({
    ...article,
    articleType: 'Blog',
    filterType: 'blog',
    href: `/blog/${article.id}/`,
  }));

const articles = [...news, ...blog].sort(
  (first, second) => second.data.publishedDate.getTime() - first.data.publishedDate.getTime(),
);
---

<Layout title="News & Blogs | NTU HPC/AI" description="Updates, announcements, and practical insights from the NTU HPC/AI community.">
  <section class="relative overflow-hidden bg-brand-navy py-16 text-brand-text-on-dark sm:py-20">
    <div class="absolute inset-0 opacity-60" aria-hidden="true">
      <div class="absolute -right-12 top-5 h-72 w-72 rounded-full border border-brand-rose/20"></div>
      <div class="absolute right-20 top-20 h-48 w-48 bg-[radial-gradient(circle,rgba(226,85,116,0.25),transparent_66%)]"></div>
      <svg class="absolute right-8 top-1/2 hidden h-52 w-72 -translate-y-1/2 text-brand-rose/65 lg:block" viewBox="0 0 300 220" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M105 22h105l52 52v124H105z"/><path d="M210 22v52h52M130 106h105M130 133h105M130 160h76"/><path class="text-brand-text-on-dark/20" d="m3 42 74 38 55-45 83 48 82-37M18 180l72-50 57 39 70-77 75 69"/></svg>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-brand-rose">NTU HPC/AI articles</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-6xl">News &amp; Blogs</h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-brand-text-on-dark/85 sm:text-lg">Updates, announcements, and practical insights from the NTU HPC/AI community.</p>
    </div>
  </section>

  <section class="bg-brand-navy pb-16 pt-2 sm:pb-20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="border-t border-brand-border-dark pt-6">
        <div class="flex gap-1" role="tablist" aria-label="Article type">
          <button class="article-filter rounded-lg bg-brand-rose px-4 py-2 text-sm font-bold text-white" type="button" data-filter="all" aria-pressed="true">All</button>
          <button class="article-filter rounded-lg px-4 py-2 text-sm font-bold text-brand-text-on-dark transition hover:bg-brand-navy-2" type="button" data-filter="news" aria-pressed="false">News</button>
          <button class="article-filter rounded-lg px-4 py-2 text-sm font-bold text-brand-text-on-dark transition hover:bg-brand-navy-2" type="button" data-filter="blog" aria-pressed="false">Blogs</button>
        </div>
      </div>

      <div class="mt-6 space-y-4" data-article-list>
        {articles.map((article) => {
          const cover = article.data.coverImage?.src ?? '/images/article-cover-default.svg';
          return (
            <article class="article-item overflow-hidden rounded-2xl border border-brand-border-dark bg-brand-navy-2 shadow-sm transition hover:border-brand-rose/70" data-article-type={article.filterType}>
              <a class="grid grid-cols-[minmax(8.5rem,0.7fr)_minmax(0,1.3fr)] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-brand-rose sm:grid-cols-[15rem_minmax(0,1fr)]" href={article.href}>
                <img class="h-full min-h-48 w-full object-cover" src={cover} alt="" loading="lazy" />
                <div class="p-5 sm:p-7">
                  <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-[0.12em]">
                    <span class="rounded-full bg-brand-rose/15 px-2.5 py-1 text-brand-rose">{article.articleType}</span>
                    <time class="text-brand-text-on-dark/60" datetime={article.data.publishedDate.toISOString()}>{dateFormatter.format(article.data.publishedDate)}</time>
                  </div>
                  <h2 class="mt-3 text-lg font-extrabold tracking-tight text-brand-text-on-dark sm:mt-4 sm:text-2xl">{article.data.title}</h2>
                  <p class="mt-2 max-w-3xl text-sm leading-6 text-brand-text-on-dark/75 sm:mt-3 sm:text-base sm:leading-7">{article.data.description}</p>
                  <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-brand-rose">Read article <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </article>
          );
        })}
      </div>
      <p class="mt-8 hidden rounded-xl border border-brand-border-dark p-5 text-center text-brand-text-on-dark/75" data-no-articles>No articles match your search.</p>
    </div>
  </section>
</Layout>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const articleItems = Array.from(document.querySelectorAll<HTMLElement>('[data-article-type]'));
  const emptyState = document.querySelector<HTMLElement>('[data-no-articles]');
  let activeFilter = 'all';

  const updateArticles = () => {
    let visibleCount = 0;
    articleItems.forEach((article) => {
      const matchesType = activeFilter === 'all' || article.dataset.articleType === activeFilter;
      const visible = matchesType;
      article.classList.toggle('hidden', !visible);
      if (visible) visibleCount += 1;
    });
    emptyState?.classList.toggle('hidden', visibleCount !== 0);
  };

  filters.forEach((filter) => filter.addEventListener('click', () => {
    activeFilter = filter.dataset.filter ?? 'all';
    filters.forEach((button) => {
      const active = button === filter;
      button.setAttribute('aria-pressed', String(active));
      button.classList.toggle('bg-brand-rose', active);
      button.classList.toggle('text-white', active);
      button.classList.toggle('text-brand-text-on-dark', !active);
    });
    updateArticles();
  }));
</script>
