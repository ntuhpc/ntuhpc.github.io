---
const sponsorModules = import.meta.glob('../../../assets/sponsors/*.{png,jpg,jpeg,webp,avif,svg}', {
  eager: true,
  query: '?url',
  import: 'default',
});

const isNtuLogo = (path: string) => /^ntu[_-]?logo\./i.test(path.split('/').pop() ?? '');

const sponsorLogos = Object.entries(sponsorModules)
  .sort(([firstPath], [secondPath]) => Number(isNtuLogo(secondPath)) - Number(isNtuLogo(firstPath)))
  .map(([path, src]) => {
    const filename = path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? 'Sponsor logo';

    return {
      src: src as string,
      alt: filename.replace(/[_-]+/g, ' '),
    };
  });
---

<footer class="border-t-4 border-brand-navy bg-brand-page text-brand-text">
  <div class="mx-auto flex max-w-7xl flex-col gap-8 px-6 py-8 lg:flex-row lg:items-center lg:px-8">
    <p class="max-w-40 text-sm font-semibold uppercase leading-6 text-brand-rose">
      Our Partners &amp; Sponsors
    </p>

    <div class="flex flex-1 flex-wrap items-center justify-start gap-x-10 gap-y-6 lg:justify-center" aria-label="Partners and sponsors">
      {sponsorLogos.map((logo) => (
        <img src={logo.src} alt={logo.alt} class="h-10 w-auto max-w-40 object-contain" loading="lazy" />
      ))}
    </div>

    <a
      href="/contact/"
      class="inline-flex shrink-0 items-center justify-center rounded-md border border-brand-rose px-5 py-3 text-sm font-semibold text-brand-rose transition-colors hover:bg-brand-rose hover:text-brand-surface"
    >
      Become a Partner <span class="ml-3" aria-hidden="true">→</span>
    </a>
  </div>
</footer>
