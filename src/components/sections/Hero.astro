---
import { Image } from 'astro:assets';
import heroImage from '../../../assets/hero2.jpg';
import { currentCompetitionFocus } from '../../data/homeContent';
---

<section class="relative isolate overflow-hidden bg-brand-navy text-brand-text-on-dark">
  <Image
    src={heroImage}
    alt="NTU HPC/AI members operating a student cluster at a competition booth"
    class="absolute inset-0 z-0 h-full w-full object-cover object-center opacity-55 sm:opacity-65 lg:opacity-75"
    widths={[768, 1152, 1536, 1707]}
    sizes="100vw"
    format="webp"
    loading="eager"
    fetchpriority="high"
  />

  <div class="pointer-events-none absolute inset-0 z-10 bg-linear-to-r from-brand-navy from-0% via-brand-navy/95 via-50% to-brand-navy/45 to-100% sm:via-brand-navy/90 lg:via-brand-navy/85 lg:to-brand-navy/25" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-0 z-10 bg-linear-to-t from-brand-navy/60 via-brand-navy/10 to-brand-navy/25" aria-hidden="true"></div>

  <div class="pointer-events-none absolute inset-0 z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -bottom-40 -left-24 h-96 w-[44rem] rounded-full border border-brand-rose/35"></div>
    <div class="absolute -bottom-48 -left-8 h-96 w-[44rem] rounded-full border border-brand-rose/20"></div>
  </div>

  <div class="relative z-20 mx-auto max-w-7xl">
    <div class="flex min-h-[18rem] max-w-2xl flex-col justify-center px-6 py-7 lg:max-w-[48%] lg:px-8">
      <p class="mb-3 inline-flex w-fit items-center gap-2 rounded-full border border-brand-rose/45 bg-brand-navy/70 px-3 py-1.5 text-xs font-semibold text-brand-text-on-dark backdrop-blur-sm sm:text-sm">
        <span class="h-2 w-2 shrink-0 rounded-full bg-brand-rose" aria-hidden="true"></span>
        {currentCompetitionFocus}
      </p>
      <h1 class="max-w-2xl text-3xl font-extrabold leading-[1.05] tracking-tight sm:text-[2rem] lg:text-[2.2rem]">
        Pushing the limits of <span class="text-brand-rose">HIGH PERFORMANCE COMPUTING.</span>
      </h1>
      <p class="mt-3 max-w-xl text-sm leading-6 text-slate-200 sm:text-[0.95rem] sm:leading-6">
        NTU High Performance Computing and AI (HPC/AI) is a student-run club driven by passion and curiosity. We build, optimise and innovate to solve real-world challenges through the power of computation and artificial intelligence.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/about/" class="inline-flex items-center justify-center rounded-md bg-brand-rose px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-coral">
          About Us <span class="ml-3" aria-hidden="true">&rarr;</span>
        </a>
        <a href="/achievements/" class="inline-flex items-center justify-center rounded-md border border-brand-rose px-4 py-2.5 text-sm font-semibold text-brand-text-on-dark transition-colors hover:bg-brand-rose/10">
          Our Achievements
        </a>
      </div>
    </div>
  </div>
</section>
